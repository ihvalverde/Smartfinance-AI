{
  "name": "smartfinance-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "install:all": "npm install",
    "build": "npm run build --workspace client",
    "vercel-build": "npm run db:generate && npm run db:deploy && npm run build --workspace client",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "npm run db:seed --workspace server",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema server/prisma/schema.prisma --force",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^5.22.0"
  }
}

# Copia este archivo a .env en la raíz del proyecto y completa los valores reales.
# Prisma CLI y el backend cargan este archivo desde la raíz.
# En Vercel estas mismas variables se configuran en Project Settings > Environment Variables.

# Neon: cadena POOLED (contiene -pooler)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Neon: cadena DIRECTA / unpooled (sin -pooler) para migraciones
DIRECT_URL="postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-de-64-bytes"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-de-64-bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google AI Studio (https://aistudio.google.com/apikey)
# Usa AI_PROVIDER="mock" para desarrollo local sin clave de Gemini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
AI_PROVIDER="gemini"

PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
